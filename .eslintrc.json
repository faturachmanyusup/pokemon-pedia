{
  "parser": "@typescript-eslint/parser",
  "extends": [
    "next/core-web-vitals"
  ],
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "indent": ["error", 2],
    "eqeqeq": "error",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["error"],
    "@typescript-eslint/no-explicit-any": "off",
    "no-console": "warn",
    "react/display-name": "off",
    "react-hooks/exhaustive-deps": "off"
  }
}
